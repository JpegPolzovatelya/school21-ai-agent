{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "title": "CPU usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}},
      "targets": [{"refId": "A", "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)", "legendFormat": "CPU"}]
    },
    {
      "title": "Available RAM",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [{"refId": "A", "expr": "node_memory_MemAvailable_bytes", "legendFormat": "Available"}]
    },
    {
      "title": "Free disk space /",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [{"refId": "A", "expr": "node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}", "legendFormat": "{{device}}"}]
    },
    {
      "title": "Disk I/O operations",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "targets": [
        {"refId": "A", "expr": "rate(node_disk_reads_completed_total{device!~\"loop.*|ram.*\"}[1m])", "legendFormat": "{{device}} reads"},
        {"refId": "B", "expr": "rate(node_disk_writes_completed_total{device!~\"loop.*|ram.*\"}[1m])", "legendFormat": "{{device}} writes"}
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["linux", "school21"],
  "time": {"from": "now-15m", "to": "now"},
  "title": "Linux Monitoring",
  "uid": "linux-monitoring",
  "version": 1
}
